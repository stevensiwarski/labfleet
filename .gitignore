!provisioning/vm.example.tfvars

# OpenTofu JSON plans can include environment-specific state and values.
*.tfplan.json

# Local plan files
*.tfplan
tfplan

# PXE configuration, generated seeds, leases, and large verified artifacts.
provisioning/.local/
provisioning/cache/
provisioning/generated/
provisioning/config.local.json
*.iso
*.img

# Override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Keep the provider lockfile!
# .terraform.lock.hcl should be committed


