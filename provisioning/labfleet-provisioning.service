# Install ONLY on an explicitly owned LabFleet provisioning host after preflight.
# Never install on the coding-agent VM or Proxmox management instance.
[Unit]
Description=LabFleet isolated PXE provisioning
After=network-online.target
Wants=network-online.target
ConditionPathExists=/etc/labfleet/provisioning-owned

[Service]
Type=simple
User=labfleet-pxe
Group=labfleet-pxe
UMask=0077
ExecStart=/usr/local/bin/provisionctl serve --config /etc/labfleet/provisioning.json
Restart=no
KillMode=control-group
TimeoutStopSec=15
AmbientCapabilities=CAP_NET_BIND_SERVICE CAP_NET_RAW CAP_NET_ADMIN
CapabilityBoundingSet=CAP_NET_BIND_SERVICE CAP_NET_RAW CAP_NET_ADMIN
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ReadWritePaths=/var/lib/labfleet/provisioning/runtime

[Install]
WantedBy=multi-user.target
